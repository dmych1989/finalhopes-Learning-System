# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Local / secrets
.env
*.log

# Vercel build artifacts (regenerated)
.vercel

# Project memory (not part of the app)
.workbuddy/

# Original Access MDB databases are NOT committed (huge, licensed, Windows-only).
# Since 2026-09 the plaintext SQLite DBs are no longer committed either: only the
# AES-encrypted *.db.enc copies ship (decrypted at runtime via DB_DECRYPT_KEY).
*.mdb
Data/
web_app/data.db
web_app/images_*.db

# Dev/diagnostic scratch inside web_app (not part of the running app).
web_app/_*.py
web_app/_carved/
web_app/_verify/
web_app/_*.png
web_app/_uv*
web_app/_trash/

# Exploratory one-off scratch in tools/ — keep only the canonical build scripts
# (mdb_to_sqlite.py, build_cat_map.py, verify_cats.py, probe_db.py) + reference .txt.
tools/brute*.py
tools/cipher_stats.py
tools/debug*.py
tools/diag*.py
tools/exe_features.py
tools/export_mdb.py
tools/fix_jet.bat
tools/run_dism.bat
tools/run_sfc.bat
tools/scan*.py
tools/schema_dump.py
tools/search_alpha.py
tools/verify_decrypt.py

# Local full-size SQLite backup (NOT committed; 96.9 MB). web_app/data.db is the
# slim committed version. The deploy script reads public/img/** from disk, not git.
web_app/data_full.db

# Static images are deployed via vercel_deploy.py (reads public/img/** from disk),
# never committed to git. public/static IS deployed (frontend assets, Vercel CDN).
public/img/
_diag/
web_app/*.c
web_app/*.so
web_app/*.srcbak

# Local deploy-state (records last deployed commit + file shas for change detection).
.vercel_deploy_state.json
.env*
node_modules/
package-lock.json
win-shell-tauri/src-tauri/target/
win-shell/bin/
win-shell/publish/
/_*.cjs
/_*.txt
/_*.js
win-shell-tauri/*.exe
win-shell-tauri/dist/
